# ⚡ APEX FORTRESS ENVIRONMENT TEMPLATE ⚡
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# All values here are placeholders — do not use real credentials.

# --- Supabase (client-safe anon key only; NEVER the service-role key) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- Omega Admin (Master Override Key for the /omega-admin ingestion gate) ---
VITE_ADMIN_PASSPHRASE=CHANGE_ME_TO_A_STRONG_PASSPHRASE

# --- Ingestion worker (server-side only; NEVER exposed to the client) ---
# Used by scripts/ingest-worker.mjs to derive ownership watermarks.
APEX_OWNERSHIP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Optional: FFmpeg binary path (defaults to `ffmpeg` on PATH) ---
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --- Optional: ingestion output directory (defaults to secure_assets/ingested) ---
# APEX_INGEST_OUT=secure_assets/ingested